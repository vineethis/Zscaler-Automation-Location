import requests
import json
import time
import logging
from datetime import datetime, timedelta

# Replace these with your Zscaler API credentials
ZSCALER_USERNAME = 'your_username'
ZSCALER_PASSWORD = 'your_password'
ZSCALER_API_KEY = 'your_api_key'
ZSCALER_BASE_URL =

# Function to obfuscate the API key
def obfuscate_api_key(api_key, timestamp):
    high = timestamp[-6:]
    low = str(int(high) >> 1)
    obfuscated_api_key = ''

    while len(low) < 6:
        low = '0' + low

    for i in high:
        obfuscated_api_key += api_key[int(i)]

    for j in low:
        obfuscated_api_key += api_key[int(j) + 2]

    return obfuscated_api_key

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler('update_locations.log'),  # Write logs to this file
        logging.StreamHandler()  # Print logs to the console
    ]
)

# Initialize a counter and timestamp for the hourly limit
hourly_limit_counter = 0
hourly_limit_reset_time = datetime.now() + timedelta(hours=1)

# Function to handle rate limiting
def rate_limit():
    global hourly_limit_counter, hourly_limit_reset_time
    # Check if the hourly limit has been reached
    if hourly_limit_counter >= 1000:
        current_time = datetime.now()
        if current_time < hourly_limit_reset_time:
            sleep_time = (hourly_limit_reset_time - current_time).total_seconds()
            logging.info(f"Hourly rate limit reached. Sleeping for {sleep_time} seconds.")
            time.sleep(sleep_time)
        # Reset the counter and the reset time
        hourly_limit_counter = 0
        hourly_limit_reset_time = datetime.now() + timedelta(hours=1)
    else:
        # Sleep to handle the 2 requests per second limit
        time.sleep(0.5)
    hourly_limit_counter += 1


# Function to authenticate and get a session cookie
def authenticate():
    timestamp = str(int(time.time() * 1000))  # Current time in milliseconds
    obfuscated_api_key = obfuscate_api_key(ZSCALER_API_KEY, timestamp)

    url = f"{ZSCALER_BASE_URL}/authenticatedSession"
    headers = {
        'Content-Type': 'application/json',
        'Cache-Control': 'no-cache',
    }
    payload = {
        'apiKey': obfuscated_api_key,
        'username': ZSCALER_USERNAME,
        'password': ZSCALER_PASSWORD,
        'timestamp': timestamp
    }
    response = requests.post(url, json=payload, headers=headers)
    if response.status_code == 200:
        return response.cookies
    else:
        print(f"Authentication failed with status code: {response.status_code}")
        print(f"Response body: {response.text}")
        raise Exception("Authentication failed")
    
# Function to update location settings
def update_location_settings(session_cookies, location_id, location_data):
    rate_limit()  # Apply rate limiting before making the PUT request
    url = f"{ZSCALER_BASE_URL}/locations/{location_id}"
    headers = {
        'Content-Type': 'application/json',
        'Cache-Control': 'no-cache',
    }
    # Update only the required fields
    location_data['ofwEnabled'] = True
    location_data['ipsControl'] = True
    response = requests.put(url, json=location_data, cookies=session_cookies, headers=headers)
    return response


# Function to get all locations and update specific records
def get_and_update_locations(session_cookies):
    page_number = 1
    page_size = 100
    url = f"{ZSCALER_BASE_URL}/locations"

    while True:
        rate_limit()  # Apply rate limiting before making the GET request
        params = {
            "page": page_number,
            "pageSize": page_size
        }
        response = requests.get(url, cookies=session_cookies, params=params)
        if response.status_code == 200:
            locations = response.json()
            for location in locations:
                location_name = location.get('name', '')
                if location_name.endswith('_ISP1') or location_name.endswith('_ISP2'):
                    location_id = location['id']
                    # Send the PUT request to update the location
                    update_response = update_location_settings(session_cookies, location_id, location)
                    if update_response.status_code == 200:
                        logging.info(f"Successfully updated location {location_name} with ID {location_id}")
                    else:
                        logging.error(f"Failed to update location {location_name} with ID {location_id}: {update_response.text}")
                else:
                    logging.info(f"Skipping location {location_name} with ID {location['id']}")

            if len(locations) < page_size:
                break  # Last page
            page_number += 1
        else:
            logging.error(f"Failed to retrieve page {page_number}: {response.status_code}")
            logging.error(f"Response: {response.text}")
            break  # Stop if there's an error

# Main execution
if __name__ == "__main__":
    try:
        session_cookies = authenticate()
        get_and_update_locations(session_cookies)
        logging.info("Completed updating locations.")
    except Exception as e:
        logging.exception("An error occurred", exc_info=e)
